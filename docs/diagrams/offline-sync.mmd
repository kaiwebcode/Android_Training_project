sequenceDiagram
    autonumber
    actor User
    participant App as Employee Task Manager
    participant Repo as ApiTaskRepository
    participant Room as TaskDao / Room
    participant WM as WorkManager
    participant Worker as TaskSyncWorker
    participant Server as Development Mock API

    User->>App: Add or complete a local task
    App->>Repo: addTask() / completeTask()
    Repo->>Room: Persist the task and pending sync operation
    Repo->>WM: scheduleSync(context)
    WM->>WM: Enqueue unique work (APPEND_OR_REPLACE, CONNECTED)
    WM->>Worker: doWork()
    Worker->>Room: resetSyncingToPending()
    Worker->>Room: getPendingSyncTasks()
    loop Each candidate
        Worker->>Room: claimForSync(candidate.id)
        opt Claim succeeded
            Worker->>Server: POST /tasks or PATCH /tasks/:id (stable clientTaskId)
            alt Valid successful response
                Server-->>Worker: Acknowledge the task
                Worker->>Room: acknowledgeMockSync(submitted, needsPatch)
                Note over Worker,Room: A stale CREATE replay can queue the newer edit as PENDING / UPDATE
                opt Acknowledgement did not apply
                    Worker->>Room: revertTaskSyncingToPending(id)
                end
            else Transient upload failure
                Server-->>Worker: HTTP 408 / 5xx or transport exception
                Worker->>Room: revertTaskSyncingToPending(id)
            end
        end
    end
    alt Transient failure or unacknowledged local edit
        Worker-->>WM: Result.retry() (exponential backoff)
    else No retry requested
        Worker-->>WM: Result.success()
    end
